# Sao chép file này thành .env và điền giá trị thật. Không commit .env lên git.
PORT=8888

# Origin của frontend, phân tách bằng dấu phẩy nếu có nhiều. Để trống khi chạy local.
CLIENT_URL=http://localhost:3000

# Redis thường
REDIS_URL=redis://127.0.0.1:6379

# Redis Sentinel (tùy chọn — nếu đặt REDIS_SENTINEL_HOST thì REDIS_URL bị bỏ qua)
# REDIS_SENTINEL_HOST=127.0.0.1
# REDIS_SENTINEL_PORT=26379
# REDIS_SENTINEL_MASTER=mymaster

# Bật giao diện quản trị Socket.IO (chỉ bật khi chạy local / có kiểm soát truy cập)
# SOCKET_ADMIN_UI=true
